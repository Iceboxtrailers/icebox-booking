// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Status/type fields are plain String rather than Prisma enum (left this way
// after the earlier SQLite-only phase; Postgres enums would work fine too but
// aren't needed). Valid values are enforced in src/lib/constants.ts and
// validated with zod in src/lib/validation.ts.

model Client {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  email                String    @unique
  phone                String
  passwordHash         String
  createdAt            DateTime  @default(now())
  verificationStatus   String    @default("pending") // pending | verified | rejected
  internalNote         String?
  status               String    @default("active") // active | suspended | blacklisted
  marketingOptIn       Boolean   @default(false)
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  billingAddress       String?
  billingCity          String?
  billingProvince      String?
  billingPostalCode    String?
  company              String?
  stripeCustomerId     String?   @unique

  reservations Reservation[]
  documents    Document[]

  @@map("clients")
}

// Internal staff login for /dashboard — deliberately separate from Client,
// no shared table or session identity between the two.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("owner") // owner | employee
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model Trailer {
  id          String   @id @default(cuid())
  name        String // physical unit label, e.g. "5x10-01"
  size        String // 5x10 | 6x12 — the only variant; pricing lives in src/lib/pricing.ts
  plate       String?
  status      String   @default("available") // available | maintenance | retired
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())

  reservations Reservation[]

  @@map("trailers")
}

model Reservation {
  id             String    @id @default(cuid())
  clientId       String
  trailerId      String?
  pickupDate     DateTime?
  returnDate     DateTime?
  dateRangeType  String    @default("fixed") // fixed | flexible
  flexWindowDays Int       @default(0)
  status         String    @default("pending") // pending | confirmed | in_progress | completed | cancelled
  totalAmount    Int       @default(0) // cents
  depositAmount  Int       @default(0) // cents
  depositStatus  String    @default("none") // none | authorized | captured | released
  note           String?
  pickupTime     String? // "HH:MM", display-only — pickupDate/returnDate stay pure dates
  returnTime     String? // "HH:MM", display-only
  usageLocation  String? // where the trailer will be used, collected in the wizard, shown on the contract
  isTest         Boolean   @default(false) // admin-flagged test booking, excluded from dashboard KPIs
  deliveryOption     String @default("pickup") // pickup | delivery
  deliveryDistanceKm Float? // one-way driving distance depot -> usageLocation, set when deliveryOption = delivery
  deliveryFeeCents   Int    @default(0) // delivery + pickup transport, pre-tax, included in totalAmount
  stripePaymentMethodId String? // card saved at booking, used to place the deposit hold before handoff
  depositExpiresAt      DateTime? // when the active hold lapses (Stripe capture_before)
  depositToken          String?   @unique // secure link letting the client re-authorize the hold
  depositTokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  trailer  Trailer?  @relation(fields: [trailerId], references: [id])
  contract Contract?
  payments Payment[]
  returnInspection ReturnInspection?

  @@index([trailerId, pickupDate, returnDate])
  @@map("reservations")
}

model Contract {
  id                     String    @id @default(cuid())
  reservationId          String    @unique
  pdfUrl                 String?
  signatureStatus        String    @default("pending") // pending | signed
  signedAt               DateTime?
  signerIp               String?
  signerName             String?
  signatureProvider      String    @default("stub") // stub | dropboxsign | docusign
  signatureTransactionId String?
  signatureImageUrl      String?
  createdAt              DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("contracts")
}

model Payment {
  id            String   @id @default(cuid())
  reservationId String
  provider      String   @default("stub") // stub | stripe
  transactionId String?
  type          String // deposit | rental | refund
  amount        Int // cents
  status        String // pending | authorized | captured | released | failed | refunded
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("payments")
}

model Document {
  id                 String   @id @default(cuid())
  clientId           String
  type               String // license | insurance
  encryptedFileUrl   String
  uploadedAt         DateTime @default(now())
  verificationStatus String   @default("pending") // pending | verified | rejected
  consentAt          DateTime // Loi 25: explicit consent timestamp, captured same request

  client Client @relation(fields: [clientId], references: [id])

  @@map("documents")
}

// Return inspection: photos + verdict recorded by staff before the deposit hold
// is released. photoPaths are private storage keys served only to admins.
model ReturnInspection {
  id                  String    @id @default(cuid())
  reservationId       String    @unique
  status              String    @default("pending") // pending | accepted | issue
  notes               String?
  photoPaths          String[]
  inspectedByAdminId  String?
  inspectedAt         DateTime?
  depositReleasedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("return_inspections")
}

// Append-only trail of every financial and inspection action. The app only ever
// inserts into this table — there is deliberately no update/delete code path.
model AuditLog {
  id            String   @id @default(cuid())
  action        String
  reservationId String?
  actorType     String // admin | client | system | stripe
  actorId       String?
  details       Json?
  createdAt     DateTime @default(now())

  @@index([reservationId, createdAt])
  @@map("audit_logs")
}
